use java.util.Comparator
use java.util.ArrayList
use java.util.Collections
use java.util.function.Function
use java.util.function.Predicate

c = Comparator.naturalOrder()
print c.compare(1, 2)
print c(1, 2)
print Function.identity()(42)

al = ArrayList()
al.add(3)
al.add(1)
Collections.reverse(al)
print al
for x in al
  print x
end

print [1, 2, 3].map(Function.identity())
print [1, 2, 3].filter(Predicate.isEqual(2))
