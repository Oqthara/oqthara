# Character frequency, exercising maps, sorting and text iteration.
text = "the quick brown fox jumps over the lazy dog"
counts = {}
for ch in text
  if ch == " "
    continue
  end
  counts[ch] = counts.get(ch, 0) + 1
end

pairs = []
for ch in counts.keys()
  pairs.push([ch, counts[ch]])
end

ranked = pairs.sort(p -> [-p[1], p[0]])
for pair in ranked.take(5)
  print "{pair[0]}: {pair[1]}"
end
