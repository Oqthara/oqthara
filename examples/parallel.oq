# Concurrency on virtual threads: three slow jobs run at the same time.
fun fetch(name)
  sleep(0.05)
  return "{name} ready"
end

start = timestamp()
tasks = []
for name in ["alpha", "beta", "gamma"]
  tasks.push(spawn(fun()
  return fetch(name)
end))
end

for task in tasks
  print await(task)
end

elapsed = timestamp() - start
print "elapsed: {elapsed} ms (sequential would be at least 150 ms)"

squares = par_map([1, 2, 3, 4, 5], x - > x * x)
print "parallel squares: {squares}"
