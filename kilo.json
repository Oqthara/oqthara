{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "bash": {
      "sudo *": "deny",
      "sudo": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "rm -rf /Users/*": "deny",
      "rm -rf .git*": "deny",
      "git clean -fdx*": "deny",
      "git clean -xfd*": "deny",
      "git reset --hard*": "deny",
      "git push --force*": "deny",
      "git push -f *": "deny",
      "git filter-branch*": "deny",
      "git rebase -i*": "deny",
      "gh repo delete*": "deny",
      "gh release delete*": "deny",
      "gh secret*": "deny",
      "gh api *--method DELETE*": "deny",
      "gh api *-X DELETE*": "deny",
      "chmod -R 777*": "deny",
      "curl *| bash*": "deny",
      "curl *| sh*": "deny",
      "docker system prune*": "deny",
      "docker rm -f*": "deny",
      "kill -9 *": "deny",
      "./gradlew *": "allow",
      "gradle *": "allow",
      "java *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git checkout -b *": "allow",
      "git switch *": "allow",
      "git push origin ai/*": "allow",
      "git push -u origin ai/*": "allow",
      "git tag *": "allow",
      "gh pr *": "allow",
      "gh run *": "allow",
      "gh release create*": "allow",
      "gh release view*": "allow",
      "gh release download*": "allow",
      "python3 *": "allow",
      "circleci config validate*": "allow",
      "docker build*": "allow",
      "docker run*": "allow"
    },
    "edit": {
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      ".oqthara-ai/STOP": "deny",
      "*": "allow"
    },
    "external_directory": "deny"
  }
}
